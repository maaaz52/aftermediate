# Public browser configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-flash-latest
# Keep Gemini primary while performance telemetry is collected. Set to nvidia
# only after comparing latency and answer quality in production.
CHAT_PRIMARY_PROVIDER=gemini
# Optional fallback for transient Gemini outages. Never expose with NEXT_PUBLIC_.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
RESEND_API_KEY=
OTP_HMAC_SECRET=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Vercel sends this value as a Bearer token to scheduled source monitoring.
# Generate a long random value and never expose it as NEXT_PUBLIC_.
CRON_SECRET=
# Comma-separated email allowlist for the private source-review dashboard.
ADMIN_EMAILS=themz52@proton.me

# Optional Cloudflare R2 video storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
